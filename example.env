# -----------------------------------------------------------------------------
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env)
# -----------------------------------------------------------------------------
# Copia este archivo como `.env` en la raíz del proyecto y completa los valores.
# NO subas el archivo `.env` a Git (está configurado en `.gitignore`).

# Autenticación con Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_poner_aqui_la_clave_publica_de_clerk"
CLERK_SECRET_KEY="sk_test_poner_aqui_la_clave_secreta_de_clerk"

# Configuración de API de Supabase
# La URL del proyecto (ej: https://damnbmjqqeaxcudxdfem.supabase.co)
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Clave Anon de Supabase (Publicable en el frontend, respeta RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Clave Service Role (Secreta en el backend, se salta RLS)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxx"

# Secreto JWT de Supabase (JWT Settings -> JWT Secret, para firmar tokens RLS)
SUPABASE_JWT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clave de Encriptación de DNI (Clave simétrica AES, opcional, por defecto usa DEMO_KEY_CHANGE_IN_PRODUCTION_12345)
# DB_ENCRYPTION_KEY="mi_clave_secreta_para_los_dnis_12345"

# Cadenas de Conexión para Migraciones (Supabase CLI)
# DATABASE_URL: Se usa para el pooler de transacciones (ej: puerto 6543)
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Conexión directa usada para migrar esquemas (ej: puerto 5432)
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# API Key de Groq LLM para el Chat
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"